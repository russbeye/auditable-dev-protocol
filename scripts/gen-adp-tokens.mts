/* Writes adp-tokens.css from the design system's tokens.json.

   Usage: node gen-adp-tokens.mts

   The design system ships its own tokens.css, but that file lags tokens.json,
   so we generate ours from the JSON and a test holds the two together. Type
   styles are not tokens in the design system's format, and adp-bundle.css
   sets every font itself, so we emit no type classes. */
import fs from "node:fs";
import path from "node:path";
import {fileURLToPath, pathToFileURL} from "node:url";

type Token = {name: string; value: string | Record<string, string>};
type Tokens = {
  color: {themes: {id: string}[]; tokens: Token[]};
  type: {families: Record<string, string>};
  [family: string]: unknown;
};

const SCRIPTS_DIR = path.dirname(fileURLToPath(import.meta.url));
const SOURCE = path.join(SCRIPTS_DIR, "tests", "fixtures", "design-system-tokens.json");
const TARGET = path.join(SCRIPTS_DIR, "adp-tokens.css");
// These families hold one value each, the same in both themes.
const PLAIN = ["spacing", "radius", "shadow", "layout"];

const decl = (name: string, value: string) => `  --${name}: ${value};\n`;

function generate(t: Tokens): string{
  const themes = t.color.themes.map(x => x.id);
  let out = "/* Generated by gen-adp-tokens.mts from the ADP design system's tokens.json. Do not edit by hand. */\n";
  for (const id of themes){
    // The first theme is the fallback, so it also answers a page that sets no data-theme.
    const sel = id === themes[0] ? `:root, :root[data-theme="${id}"]` : `:root[data-theme="${id}"]`;
    out += sel + " {\n";
    for (const tok of t.color.tokens){
      const v = typeof tok.value === "string" ? tok.value : tok.value[id] ?? tok.value[themes[0]];
      out += decl(tok.name, v);
    }
    out += "}\n";
  }
  out += ":root {\n";
  for (const [name, stack] of Object.entries(t.type.families)) out += decl("font-" + name, stack);
  for (const fam of PLAIN){
    const list = (t[fam] as {tokens: Token[]} | undefined)?.tokens || [];
    for (const tok of list) out += decl(tok.name, tok.value as string);
  }
  return out + "}\n";
}

if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href)
  fs.writeFileSync(TARGET, generate(JSON.parse(fs.readFileSync(SOURCE, "utf8"))));

export {generate, PLAIN};
