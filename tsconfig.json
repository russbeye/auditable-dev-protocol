{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["scripts/*.mts", "scripts/tests/*.mts", "src/**/*.ts", "src/**/*.tsx", "vite.config.mts"]
}
